# Mira Dashboard managed unit.
[Unit]
Description=Mira Dashboard reviewed host cleanup
After=network-online.target docker.service systemd-journald.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0022
ExecStart=/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C LC_ALL=C DEBIAN_FRONTEND=noninteractive HOME=/root USER=root LOGNAME=root SHELL=/bin/sh /usr/local/libexec/mira-dashboard-host-operation system-cleanup
StandardOutput=null
StandardError=null
TimeoutStartSec=30min
