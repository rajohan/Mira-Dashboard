{
  "$id": "urn:mira-dashboard:auth.sessions.output",
  "type": "object",
  "properties": {
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "authenticatedAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "authMethod": {
            "enum": [
              "password",
              "recovery",
              "totp"
            ],
            "type": "string"
          },
          "createdAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "expiresAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "id": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[0-9a-f]{32}$"
          },
          "isCurrent": {
            "type": "boolean"
          },
          "lastSeenAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "userAgent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$"
          }
        },
        "required": [
          "authenticatedAtMs",
          "authMethod",
          "createdAtMs",
          "expiresAtMs",
          "id",
          "isCurrent",
          "lastSeenAtMs"
        ],
        "additionalProperties": false
      },
      "maxItems": 16
    }
  },
  "required": [
    "sessions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
