{
  "$id": "urn:mira-dashboard:backups.clearKopiaAttention.input",
  "type": "object",
  "properties": {
    "attentionRunId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "confirmation": {
      "const": "clear-kopia-backup-attention"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "attentionRunId",
    "confirmation",
    "idempotencyKey",
    "sourceRevision"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
