{
  "$id": "urn:mira-dashboard:delivery.approvePullRequest.input",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "checkoutRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "confirmation": {
          "const": "merge-delivery-pull-request"
        },
        "expectedHeads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "headSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "headSha",
              "number"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100,
          "$comment": "Live Valibot validation additionally requires every pull request number in an exact Delivery scope to be unique."
        },
        "mergeStack": {
          "type": "boolean"
        },
        "operation": {
          "const": "merge-pull-request"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "deploy": {
          "const": false
        }
      },
      "required": [
        "checkoutRevision",
        "confirmation",
        "expectedHeads",
        "mergeStack",
        "operation",
        "idempotencyKey",
        "sourceRevision",
        "number",
        "deploy"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "checkoutRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "confirmation": {
          "const": "merge-and-deploy-delivery-pull-request"
        },
        "expectedHeads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "headSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "headSha",
              "number"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100,
          "$comment": "Live Valibot validation additionally requires every pull request number in an exact Delivery scope to be unique."
        },
        "mergeStack": {
          "type": "boolean"
        },
        "operation": {
          "const": "merge-pull-request"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "activationRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "deploy": {
          "const": true
        }
      },
      "required": [
        "checkoutRevision",
        "confirmation",
        "expectedHeads",
        "mergeStack",
        "operation",
        "idempotencyKey",
        "sourceRevision",
        "number",
        "activationRevision",
        "deploy"
      ],
      "additionalProperties": false
    }
  ],
  "$comment": "Live Valibot validation additionally requires the selected pull request and exact head to be the final member of its submitted scope.",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
