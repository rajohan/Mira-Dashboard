{
  "$id": "urn:mira-dashboard:delivery.deployCurrent.input",
  "type": "object",
  "properties": {
    "confirmation": {
      "const": "deploy-delivery-main"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
    }
  },
  "required": [
    "confirmation",
    "idempotencyKey"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
