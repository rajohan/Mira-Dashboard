{
  "$id": "urn:mira-dashboard:docker.preparePrune.output",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "issuedAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ticketId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "estimatedReclaimableBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 512,
                  "minLength": 1,
                  "pattern": "\\S",
                  "allOf": [
                    {
                      "pattern": "^[^\\u0000]*$"
                    },
                    {
                      "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]*$"
                    }
                  ]
                },
                "maxItems": 64,
                "$comment": "Live Valibot validation additionally requires Docker string inventories to be unique and strictly ordered."
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "references",
              "sizeBytes"
            ],
            "additionalProperties": false
          },
          "maxItems": 512,
          "$comment": "Live Valibot validation additionally requires Docker object IDs to be unique and strictly ordered."
        },
        "target": {
          "const": "images"
        }
      },
      "required": [
        "expiresAtMs",
        "issuedAtMs",
        "sourceRevision",
        "ticketId",
        "estimatedReclaimableBytes",
        "items",
        "target"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "issuedAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ticketId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "estimatedReclaimableBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "maxItems": 256,
          "$comment": "Live Valibot validation additionally requires Docker object names to be unique and strictly ordered."
        },
        "target": {
          "const": "volumes"
        }
      },
      "required": [
        "expiresAtMs",
        "issuedAtMs",
        "sourceRevision",
        "ticketId",
        "estimatedReclaimableBytes",
        "items",
        "target"
      ],
      "additionalProperties": false
    }
  ],
  "$comment": "Live Valibot validation additionally requires Docker prune tickets to expire after issuance and within five minutes.",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
