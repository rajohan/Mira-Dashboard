{
  "$id": "urn:mira-dashboard:backups.runKopia.output",
  "type": "object",
  "properties": {
    "jobRunId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": {
      "enum": [
        "clear-attention",
        "run"
      ],
      "type": "string"
    },
    "queued": {
      "const": true
    },
    "type": {
      "enum": [
        "kopia",
        "walg"
      ],
      "type": "string"
    }
  },
  "required": [
    "jobRunId",
    "operation",
    "queued",
    "type"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
