{
  "$id": "urn:mira-dashboard:files.prepareContent.input",
  "type": "object",
  "properties": {
    "disposition": {
      "enum": [
        "download",
        "preview"
      ],
      "type": "string"
    },
    "resourceId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "disposition",
    "resourceId"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
