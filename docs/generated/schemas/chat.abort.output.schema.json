{
  "$id": "urn:mira-dashboard:chat.abort.output",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "aborted": {
          "type": "boolean"
        },
        "run": {
          "type": "object",
          "properties": {
            "admittedAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "cancelRequestedAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "failureCode": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "\\S",
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                },
                {
                  "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]*$"
                }
              ]
            },
            "failureMessage": {
              "type": "string",
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ]
            },
            "id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "providerRunId": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1,
              "pattern": "\\S",
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                },
                {
                  "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]*$"
                }
              ]
            },
            "reconciliation": {
              "enum": [
                "failed",
                "history-authoritative",
                "pending",
                "runtime-authoritative"
              ],
              "type": "string"
            },
            "reconciledAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "sessionKey": {
              "type": "string",
              "maxLength": 512,
              "minLength": 1,
              "pattern": "\\S",
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                },
                {
                  "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]*$"
                }
              ]
            },
            "state": {
              "enum": [
                "active",
                "admitted",
                "cancel-requested",
                "cancelled",
                "completed",
                "failed",
                "interrupted",
                "outcome-unknown",
                "unresolved"
              ],
              "type": "string"
            },
            "stateVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "terminalAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "updatedAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            }
          },
          "required": [
            "admittedAtMs",
            "id",
            "reconciliation",
            "sessionKey",
            "state",
            "stateVersion",
            "updatedAtMs"
          ],
          "additionalProperties": false,
          "$comment": "Live Valibot validation additionally binds chat run lifecycle, terminal, cancellation, reconciliation, and update timestamps."
        }
      },
      "required": [
        "aborted",
        "run"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "aborted": {
          "type": "boolean"
        },
        "abortAttemptId": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "\\S",
          "allOf": [
            {
              "pattern": "^[^\\u0000]*$"
            },
            {
              "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]*$"
            }
          ]
        },
        "providerRunId": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "\\S",
          "allOf": [
            {
              "pattern": "^[^\\u0000]*$"
            },
            {
              "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]*$"
            }
          ]
        }
      },
      "required": [
        "aborted",
        "abortAttemptId",
        "providerRunId"
      ],
      "additionalProperties": false
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
