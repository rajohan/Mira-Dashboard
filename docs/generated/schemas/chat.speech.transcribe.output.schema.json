{
  "$id": "urn:mira-dashboard:chat.speech.transcribe.output",
  "type": "object",
  "properties": {
    "transcript": {
      "type": "string",
      "maxLength": 32000,
      "minLength": 1,
      "pattern": "\\S",
      "allOf": [
        {
          "pattern": "^[^\\u0000]*$"
        }
      ],
      "$comment": "Live Valibot validation additionally limits the ephemeral transcript to 65536 UTF-8 bytes."
    }
  },
  "required": [
    "transcript"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
