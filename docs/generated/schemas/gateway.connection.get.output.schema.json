{
  "$id": "urn:mira-dashboard:gateway.connection.get.output",
  "type": "object",
  "properties": {
    "checkedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "connectedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "connectionGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "freshness": {
      "enum": [
        "fresh",
        "stale",
        "unavailable"
      ],
      "type": "string"
    },
    "lastActivityAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "lastDisconnectedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "nextReconnectAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "phase": {
      "enum": [
        "connected",
        "connecting",
        "degraded",
        "stopped",
        "stopping"
      ],
      "type": "string"
    },
    "reconnectAttempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "checkedAtMs",
    "connectionGeneration",
    "freshness",
    "phase",
    "reconnectAttempt"
  ],
  "additionalProperties": false,
  "$comment": "Live Valibot validation additionally requires connected phase and fresh state to agree and past transport timestamps not to exceed the check time.",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
