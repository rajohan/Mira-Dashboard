{
  "$id": "urn:mira-dashboard:docker.getContainerLogs.input",
  "type": "object",
  "properties": {
    "containerId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tail": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 200
    }
  },
  "required": [
    "containerId",
    "sourceRevision"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
