{
  "$id": "urn:mira-dashboard:automationSecurity.listCredentials.output",
  "type": "object",
  "properties": {
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "createdAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "expiresAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]+$"
          },
          "prefix": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[0-9a-f]{32}$"
          },
          "replacesCredentialId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "revokedAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8640000000000000
          }
        },
        "required": [
          "createdAtMs",
          "id",
          "label",
          "prefix"
        ],
        "additionalProperties": false,
        "$comment": "Live Valibot validation additionally requires credential expiry after creation and revocation no earlier than creation. Live Valibot validation additionally requires a replacement credential to reference a different credential ID."
      },
      "maxItems": 50,
      "$comment": "Live Valibot validation additionally requires strict newest-first ordering by creation timestamp and ID."
    },
    "nextCursor": {
      "type": "object",
      "properties": {
        "createdAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "createdAtMs",
        "id"
      ],
      "additionalProperties": false
    },
    "principalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "totalCredentialCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "credentials",
    "principalId",
    "totalCredentialCount"
  ],
  "additionalProperties": false,
  "$comment": "Live Valibot validation additionally requires the credential page count not to exceed the total count. Live Valibot validation additionally requires a credential continuation cursor to identify the returned last row.",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
