{
  "$id": "urn:mira-dashboard:delivery.deploy.input",
  "type": "object",
  "properties": {
    "activationRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checkoutRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "confirmation": {
      "const": "deploy-delivery-main"
    },
    "expectedMainHeadSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "operation": {
      "const": "deploy"
    },
    "release": {
      "type": "object",
      "properties": {
        "assets": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f\\d]{64}$"
                    },
                    "name": {
                      "const": "receipt.json"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4194304
                    }
                  },
                  "required": [
                    "digest",
                    "name",
                    "size"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f\\d]{64}$"
                    },
                    "name": {
                      "const": "release.tar"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 570425344
                    }
                  },
                  "required": [
                    "digest",
                    "name",
                    "size"
                  ],
                  "additionalProperties": false
                }
              ],
              "minItems": 2
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f\\d]{64}$"
                    },
                    "name": {
                      "const": "release.tar"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 570425344
                    }
                  },
                  "required": [
                    "digest",
                    "name",
                    "size"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f\\d]{64}$"
                    },
                    "name": {
                      "const": "receipt.json"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4194304
                    }
                  },
                  "required": [
                    "digest",
                    "name",
                    "size"
                  ],
                  "additionalProperties": false
                }
              ],
              "minItems": 2
            }
          ]
        },
        "releaseId": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "releaseManifestSha256": {
          "type": "string",
          "pattern": "^[a-f\\d]{64}$"
        },
        "runtime": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "revision",
            "version"
          ],
          "additionalProperties": false
        },
        "tagName": {
          "type": "string",
          "maxLength": 34,
          "pattern": "^v\\d+\\.\\d+\\.\\d+(?:[.-][0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "assets",
        "releaseId",
        "releaseManifestSha256",
        "runtime",
        "tagName"
      ],
      "additionalProperties": false
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "activationRevision",
    "checkoutRevision",
    "confirmation",
    "expectedMainHeadSha",
    "operation",
    "release",
    "idempotencyKey",
    "sourceRevision"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
