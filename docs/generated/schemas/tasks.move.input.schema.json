{
  "$id": "urn:mira-dashboard:tasks.move.input",
  "type": "object",
  "properties": {
    "expectedVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": {
      "enum": [
        "todo",
        "in-progress",
        "blocked",
        "done"
      ],
      "type": "string"
    }
  },
  "required": [
    "expectedVersion",
    "id",
    "status"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
