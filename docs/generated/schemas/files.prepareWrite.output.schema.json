{
  "$id": "urn:mira-dashboard:files.prepareWrite.output",
  "type": "object",
  "properties": {
    "expiresAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "ticketId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uploadUrl": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^\\/api\\/files\\/uploads\\/[0-9a-f-]{36}$"
    }
  },
  "required": [
    "expiresAtMs",
    "ticketId",
    "uploadUrl"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
