{
  "$id": "urn:mira-dashboard:terminal.prepareSession.input",
  "type": "object",
  "properties": {
    "dimensions": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 2,
          "maximum": 400
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^\\/(?:[^/\\r\\n]+(?:\\/[^/\\r\\n]+)*)?$",
          "$comment": "Live Valibot validation additionally rejects dot and parent segments in the root-relative initial terminal path."
        },
        "rootId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "required": [
        "path",
        "rootId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "dimensions",
    "location"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
