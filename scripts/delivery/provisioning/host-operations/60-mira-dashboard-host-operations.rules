polkit.addRule(function (action, subject) {
    if (
        action.id !== "org.freedesktop.systemd1.manage-units" ||
        subject.user !== "ubuntu"
    ) {
        return polkit.Result.NOT_HANDLED;
    }

    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var hostOperations = [
        "mira-dashboard-host-system-cleanup.service",
        "mira-dashboard-host-system-restart.service",
        "mira-dashboard-host-system-update.service",
        "mira-dashboard-deferred-stack-restart.timer",
        "mira-dashboard-deferred-worker-restart.timer"
    ];
    if (verb === "start" && hostOperations.indexOf(unit) !== -1) {
        return polkit.Result.YES;
    }
    if (
        verb === "start" &&
        /^mira-p@[a-f0-9]{40}--(?:local(?:--settled)?|v[0-9]+\.[0-9]+\.[0-9]+(?:[.-][0-9A-Za-z.-]+)?--[a-f0-9]{64}--[a-f0-9]{64})\.service$/.test(unit)
    ) {
        return polkit.Result.YES;
    }

    var applicationUnits = [
        "mira-dashboard-web.service",
        "mira-dashboard-worker.service"
    ];
    var applicationVerbs = ["restart", "start", "stop"];
    if (
        applicationUnits.indexOf(unit) !== -1 &&
        applicationVerbs.indexOf(verb) !== -1
    ) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
