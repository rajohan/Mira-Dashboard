        "sessions.groups.rename",
        "sessions.list",
        "sessions.messages.subscribe",
        "sessions.messages.unsubscribe",
        "sessions.observer.visibility",
        "sessions.patch",
        "sessions.pluginPatch",
        "sessions.preview",
        "sessions.reclaim",
        "sessions.reset",
        "sessions.resolve",
        "sessions.rewind",
        "sessions.search",
        "sessions.send",
        "sessions.steer",
