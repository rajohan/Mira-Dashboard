{
    "gatewayEvents": [
        "session.approval",
        "session.message",
        "session.observer",
        "session.operation",
        "session.sharing",
        "session.suggestion",
        "session.tool",
        "session.typing",
        "sessions.changed"
    ],
    "methods": [
        "session.discussion.info",
        "session.discussion.open",
        "session.members.add",
        "session.members.list",
        "session.members.remove",
        "session.suggestions.add",
        "session.suggestions.list",
