{
    "name": "mira-dashboard",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun scripts/developmentStack.ts",
        "dev:database:reset": "bun scripts/developmentStack.ts --reset-database",
        "dev:doppler": "doppler run --project rajohan --config prd --only-secrets OPENCLAW_GATEWAY_TOKEN,MOLTBOOK_API_KEY,ELEVENLABS_API_KEY,MIRA_DASHBOARD_SESSION_IDLE_MINUTES,MIRA_DASHBOARD_RECENT_AUTH_MINUTES --no-exit-on-missing-only-secrets -- bun scripts/developmentStack.ts",
        "dev:remote": "bun scripts/development/developmentTailscale.ts run",
        "dev:remote:disable": "bun scripts/development/developmentTailscale.ts disable",
        "dev:remote:doppler": "doppler run --project rajohan --config prd --only-secrets OPENCLAW_GATEWAY_TOKEN,MOLTBOOK_API_KEY,ELEVENLABS_API_KEY,MIRA_DASHBOARD_SESSION_IDLE_MINUTES,MIRA_DASHBOARD_RECENT_AUTH_MINUTES --no-exit-on-missing-only-secrets -- bun scripts/development/developmentTailscale.ts run",
        "dev:remote:enable": "bun scripts/development/developmentTailscale.ts enable",
        "dev:remote:status": "bun scripts/development/developmentTailscale.ts status",
        "dev:state:prepare": "bun scripts/developmentStack.ts --prepare-state",
        "dev:state:reset": "bun scripts/developmentStack.ts --reset-state",
        "auth:reset-password": "/usr/bin/env -i NODE_ENV=production /home/ubuntu/projects/mira-dashboard/production/runtimes/bun/current/bun /home/ubuntu/projects/mira-dashboard/production/releases/current/server/resetDashboardPassword.js --project-root=/home/ubuntu/projects/mira-dashboard",
        "check:boundaries": "bun scripts/checkSourceBoundaries.ts",
        "build:browser": "bun scripts/delivery/buildBrowser.ts",
        "build:processes": "bun scripts/delivery/buildProcesses.ts",
        "build:release": "bun scripts/delivery/buildRelease.ts",
        "build:storybook": "storybook build --output-dir dist/storybook --test --quiet --disable-telemetry",
        "db:check": "bun scripts/checkDatabaseSchema.ts",
        "db:generate": "drizzle-kit generate --config drizzle.config.ts --output json",
        "docs:check": "bun scripts/generateDocs.ts --check",
        "docs:generate": "bun scripts/generateDocs.ts",
        "delivery:prepare-state": "bun scripts/delivery/prepareProductionState.ts",
        "delivery:install-log-maintenance": "bun scripts/delivery/provisioning/log-maintenance/installLogMaintenanceProvisioning.ts",
        "delivery:activate": "bun scripts/delivery/activateProductionRelease.ts",
        "format": "oxfmt --config oxfmt.config.ts --write .",
        "format:check": "oxfmt --config oxfmt.config.ts --check .",
        "lint": "bun run --parallel lint:bun lint:browser lint:storybook",
        "lint:browser": "oxlint src/browser --tsconfig tsconfig.browser.json --ignore-pattern '**/*.stories.tsx' --ignore-pattern '**/storySupport/**' --no-error-on-unmatched-pattern",
        "lint:bun": "oxlint . --tsconfig tsconfig.bun.json --ignore-pattern 'src/browser/**' --ignore-pattern '.storybook/manager.ts' --ignore-pattern '.storybook/preview.tsx'",
        "lint:storybook": "bun scripts/lintStorybook.ts",
        "lint:fix": "bun run --parallel lint:fix:bun lint:fix:browser lint:fix:storybook",
        "lint:fix:browser": "oxlint src/browser --fix --tsconfig tsconfig.browser.json --ignore-pattern '**/*.stories.tsx' --ignore-pattern '**/storySupport/**' --no-error-on-unmatched-pattern",
        "lint:fix:bun": "oxlint . --fix --tsconfig tsconfig.bun.json --ignore-pattern 'src/browser/**' --ignore-pattern '.storybook/manager.ts' --ignore-pattern '.storybook/preview.tsx'",
        "lint:fix:storybook": "bun scripts/lintStorybook.ts --fix",
        "storybook": "storybook dev --port 6006 --no-open --disable-telemetry",
        "storybook:install-browser": "PLAYWRIGHT_BROWSERS_PATH=node_modules/.cache/playwright playwright install chromium --only-shell",
        "evidence:resources:sse": "bun src/test/integration/resources/runSseMemoryEvidence.ts",
        "test": "bun run test:bun && bun run test:browser && bun run test:storybook",
        "test:browser": "bun scripts/runBatchedTestSuite.ts browser",
        "test:bun": "bun scripts/runBatchedTestSuite.ts bun",
        "test:coverage": "PLAYWRIGHT_BROWSERS_PATH=node_modules/.cache/playwright bun scripts/runCoverage.ts",
        "test:coverage:browser": "bun scripts/runCoverage.ts --partition=browser",
        "test:coverage:bun": "bun scripts/runCoverage.ts --partition=bun",
        "test:coverage:merge": "bun scripts/runCoverage.ts --merge",
        "test:coverage:storybook": "PLAYWRIGHT_BROWSERS_PATH=node_modules/.cache/playwright bun scripts/runCoverage.ts --partition=storybook",
        "test:storybook": "PLAYWRIGHT_BROWSERS_PATH=node_modules/.cache/playwright bun scripts/runStorybookTests.ts",
        "test:timings:update": "bun run test:timings:update:browser && bun run test:timings:update:storybook && bun run test:timings:update:bun",
        "test:timings:update:browser": "bun scripts/runBatchedTestSuite.ts browser --update-timings",
        "test:timings:update:bun": "bun scripts/runBatchedTestSuite.ts bun --update-timings",
        "test:timings:update:storybook": "PLAYWRIGHT_BROWSERS_PATH=node_modules/.cache/playwright bun scripts/runStorybookTests.ts --update-timings",
        "typecheck": "bun run --parallel typecheck:browser typecheck:storybook typecheck:bun",
        "typecheck:browser": "bun node_modules/typescript/bin/tsc -p tsconfig.browser.json --noEmit",
        "typecheck:bun": "bun node_modules/typescript/bin/tsc -p tsconfig.bun.json --noEmit",
        "typecheck:storybook": "bun node_modules/typescript/bin/tsc -p tsconfig.storybook.json --noEmit"
    },
    "dependencies": {
        "@date-fns/tz": "^1.5.0",
        "@daypicker/react": "10.0.1",
        "@dnd-kit/react": "^0.5.0",
        "@headlessui/react": "^2.2.10",
        "@simplewebauthn/browser": "13.3.0",
        "@simplewebauthn/server": "13.3.2",
        "@tailwindcss/typography": "^0.5.20",
        "@tanstack/db": "0.8.1",
        "@tanstack/query-core": "5.101.4",
        "@tanstack/query-db-collection": "1.2.6",
        "@tanstack/react-db": "0.3.1",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-router": "^1.170.31",
        "@tanstack/react-store": "0.11.1",
        "@tanstack/react-table": "^9.1.2",
        "@tanstack/react-virtual": "^3.14.10",
        "@trpc/client": "11.18.0",
        "@trpc/server": "11.18.0",
        "@xterm/addon-fit": "0.11.0",
        "@xterm/addon-search": "0.16.0",
        "@xterm/xterm": "6.0.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "drizzle-orm": "^1.0.0-rc.5-169397b",
        "effect": "4.0.0-rc.111",
        "json5": "^2.2.3",
        "lucide-react": "1.33.0",
        "otplib": "13.4.1",
        "qrcode.react": "4.2.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-error-boundary": "^6.1.3",
        "react-markdown": "^10.1.0",
        "react-syntax-highlighter": "^16.1.1",
        "remark-gfm": "^4.0.1",
        "superjson": "2.2.6",
        "tailwind-merge": "^3.6.0",
        "valibot": "^1.4.2"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^20.11.6",
        "@storybook/addon-a11y": "10.6.0-alpha.7",
        "@storybook/addon-docs": "10.6.0-alpha.7",
        "@storybook/addon-vitest": "10.6.0-alpha.7",
        "@storybook/tanstack-react": "10.6.0-alpha.7",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.5",
        "@types/node": "26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@typescript-eslint/scope-manager": "8.67.0",
        "@valibot/to-json-schema": "1.7.1",
        "@vitest/browser-playwright": "4.1.11",
        "@vitest/coverage-v8": "4.1.11",
        "bun-plugin-tailwind": "^0.1.2",
        "bun-types": "1.4.0",
        "drizzle-kit": "^1.0.0-rc.5-ab785fc",
        "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
        "eslint-plugin-storybook": "10.6.0-alpha.7",
        "eventsource": "5.1.1",
        "happy-dom": "^20.11.6",
        "lcov-result-merger": "^6.0.0",
        "oxc-parser": "0.146.0",
        "oxfmt": "^0.64.0",
        "oxlint": "1.79.0",
        "oxlint-config-presets": "^0.1.19",
        "oxlint-tailwindcss": "^1.10.0",
        "oxlint-tsgolint": "^7.0.2001",
        "playwright": "1.62.1",
        "storybook": "10.6.0-alpha.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "8.2.2",
        "vitest": "4.1.11"
    },
    "browserslist": [
        "Chrome >= 140",
        "Firefox >= 133",
        "Safari >= 18.4"
    ]
}
