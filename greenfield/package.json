{
    "name": "mira-dashboard",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun scripts/developmentStack.ts",
        "dev:database:reset": "bun scripts/developmentStack.ts --reset-database",
        "dev:doppler": "doppler run --project rajohan --config prd --only-secrets OPENCLAW_GATEWAY_TOKEN,MOLTBOOK_API_KEY,MIRA_DASHBOARD_SESSION_IDLE_MINUTES,MIRA_DASHBOARD_RECENT_AUTH_MINUTES --no-exit-on-missing-only-secrets -- bun scripts/developmentStack.ts",
        "dev:remote": "bun scripts/development/developmentTailscale.ts run",
        "dev:remote:disable": "bun scripts/development/developmentTailscale.ts disable",
        "dev:remote:doppler": "doppler run --project rajohan --config prd --only-secrets OPENCLAW_GATEWAY_TOKEN,MOLTBOOK_API_KEY,MIRA_DASHBOARD_SESSION_IDLE_MINUTES,MIRA_DASHBOARD_RECENT_AUTH_MINUTES --no-exit-on-missing-only-secrets -- bun scripts/development/developmentTailscale.ts run",
        "dev:remote:enable": "bun scripts/development/developmentTailscale.ts enable",
        "dev:remote:status": "bun scripts/development/developmentTailscale.ts status",
        "dev:state:prepare": "bun scripts/developmentStack.ts --prepare-state",
        "dev:state:reset": "bun scripts/developmentStack.ts --reset-state",
        "check:boundaries": "bun scripts/checkSourceBoundaries.ts",
        "build:browser": "bun scripts/delivery/buildBrowser.ts",
        "build:processes": "bun scripts/delivery/buildProcesses.ts",
        "build:release": "bun scripts/delivery/buildRelease.ts",
        "db:check": "bun scripts/checkDatabaseSchema.ts",
        "db:generate": "drizzle-kit generate --config drizzle.config.ts --output json",
        "docs:check": "bun scripts/generateDocs.ts --check",
        "docs:generate": "bun scripts/generateDocs.ts",
        "delivery:prepare-state": "bun scripts/delivery/prepareProductionState.ts",
        "delivery:install-log-maintenance": "bun scripts/delivery/provisioning/log-maintenance/installLogMaintenanceProvisioning.ts",
        "delivery:activate": "bun scripts/delivery/activateProductionRelease.ts",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "bun run lint:bun && bun run lint:browser && bun run lint:storybook",
        "lint:browser": "oxlint src/browser --tsconfig tsconfig.browser.json --ignore-pattern '**/*.stories.tsx' --ignore-pattern '**/storySupport/**' --no-error-on-unmatched-pattern",
        "lint:bun": "oxlint . --tsconfig tsconfig.bun.json --ignore-pattern 'src/browser/**' --ignore-pattern '.storybook/manager.ts' --ignore-pattern '.storybook/preview.tsx'",
        "lint:storybook": "oxlint .storybook/manager.ts .storybook/preview.tsx 'src/browser/**/*.stories.tsx' 'src/browser/**/storySupport/**/*.{ts,tsx}' --tsconfig tsconfig.storybook.json --no-error-on-unmatched-pattern",
        "lint:fix": "oxlint . --fix --tsconfig tsconfig.bun.json --ignore-pattern 'src/browser/**' --ignore-pattern '.storybook/manager.ts' --ignore-pattern '.storybook/preview.tsx' && oxlint src/browser --fix --tsconfig tsconfig.browser.json --ignore-pattern '**/*.stories.tsx' --ignore-pattern '**/storySupport/**' --no-error-on-unmatched-pattern && oxlint .storybook/manager.ts .storybook/preview.tsx 'src/browser/**/*.stories.tsx' 'src/browser/**/storySupport/**/*.{ts,tsx}' --fix --tsconfig tsconfig.storybook.json --no-error-on-unmatched-pattern",
        "setup:before-push": "bun run test:timings:update",
        "storybook": "storybook dev --port 6006 --no-open --disable-telemetry",
        "storybook:build": "storybook build --output-dir dist/storybook --test --quiet --disable-telemetry",
        "storybook:install-browser": "PLAYWRIGHT_BROWSERS_PATH=node_modules/.cache/playwright playwright install chromium",
        "storybook:test": "PLAYWRIGHT_BROWSERS_PATH=node_modules/.cache/playwright bun scripts/runStorybookTests.ts",
        "evidence:resources:sse": "bun src/test/integration/resources/runSseMemoryEvidence.ts",
        "test": "bun run test:bun && bun run test:browser",
        "test:browser": "bun scripts/runTestSuite.ts --parallel=3 --timings=.bun-browser-test-timings.json --preload ./src/browser/test/setup.ts --bail=1 src/browser",
        "test:bun": "bun scripts/runTestSuite.ts --parallel=3 --timings=.bun-test-timings.json --bail=1 scripts src/app src/contracts src/server src/shared src/test src/worker",
        "test:coverage": "bun scripts/runCoverage.ts",
        "test:timings:update": "bun run test:timings:update:bun && bun run test:timings:update:browser",
        "test:timings:update:browser": "bun scripts/runTestSuite.ts --only-failures --parallel=3 --timings=.bun-browser-test-timings.json --update-timings --preload ./src/browser/test/setup.ts --bail=1 src/browser",
        "test:timings:update:bun": "bun scripts/runTestSuite.ts --only-failures --parallel=3 --timings=.bun-test-timings.json --update-timings --bail=1 scripts src/app src/contracts src/server src/shared src/test src/worker",
        "typecheck": "bun run typecheck:browser && bun run typecheck:storybook && bun run typecheck:bun",
        "typecheck:browser": "bun node_modules/typescript/bin/tsc -p tsconfig.browser.json --noEmit",
        "typecheck:bun": "bun node_modules/typescript/bin/tsc -p tsconfig.bun.json --noEmit",
        "typecheck:storybook": "bun node_modules/typescript/bin/tsc -p tsconfig.storybook.json --noEmit"
    },
    "dependencies": {
        "@daypicker/react": "10.0.1",
        "@dnd-kit/react": "^0.5.0",
        "@headlessui/react": "^2.2.10",
        "@microlink/react-json-view": "^1.31.28",
        "@simplewebauthn/browser": "13.3.0",
        "@simplewebauthn/server": "13.3.2",
        "@tailwindcss/typography": "^0.5.20",
        "@tanstack/db": "0.6.17",
        "@tanstack/query-core": "5.101.4",
        "@tanstack/query-db-collection": "1.2.1",
        "@tanstack/react-db": "0.1.95",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-router": "^1.170.27",
        "@tanstack/react-store": "0.11.1",
        "@tanstack/react-table": "^9.1.2",
        "@tanstack/react-virtual": "^3.14.9",
        "@trpc/client": "11.18.0",
        "@trpc/server": "11.18.0",
        "@trpc/tanstack-react-query": "11.18.0",
        "@xterm/addon-fit": "0.11.0",
        "@xterm/addon-search": "0.16.0",
        "@xterm/xterm": "6.0.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "drizzle-orm": "1.0.0-rc.4",
        "effect": "4.0.0-beta.107",
        "json5": "^2.2.3",
        "lucide-react": "^1.31.0",
        "otplib": "13.4.1",
        "qrcode.react": "4.2.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-error-boundary": "^6.1.2",
        "react-markdown": "^10.1.0",
        "react-syntax-highlighter": "^16.1.1",
        "refractor": "^5.0.0",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "superjson": "2.2.6",
        "tailwind-merge": "^3.6.0",
        "valibot": "^1.4.2"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@happy-dom/global-registrator": "^20.11.2",
        "@storybook/addon-a11y": "10.6.0-alpha.5",
        "@storybook/addon-docs": "10.6.0-alpha.5",
        "@storybook/addon-vitest": "10.6.0-alpha.5",
        "@storybook/tanstack-react": "10.6.0-alpha.5",
        "@tailwindcss/vite": "4.3.3",
        "@tanstack/react-devtools": "^0.10.10",
        "@tanstack/react-form-devtools": "^0.2.34",
        "@tanstack/react-query-devtools": "^5.101.4",
        "@tanstack/react-router-devtools": "1.167.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.4",
        "@types/babel__core": "^7.20.5",
        "@types/node": "26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@valibot/to-json-schema": "1.7.1",
        "@vitest/browser-playwright": "4.1.10",
        "babel-plugin-react-compiler": "^1.0.0",
        "bun-plugin-tailwind": "^0.1.2",
        "bun-types": "1.4.0-canary.20260519T150915",
        "drizzle-kit": "1.0.0-rc.4",
        "eventsource": "5.0.0",
        "happy-dom": "^20.11.2",
        "jsdom-testing-mocks": "^1.16.0",
        "jsonc-parser": "3.3.1",
        "lcov-result-merger": "^6.0.0",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "oxlint-config-presets": "^0.1.19",
        "oxlint-tailwindcss": "^1.9.0",
        "oxlint-tsgolint": "^7.0.2001",
        "playwright": "1.62.1",
        "storybook": "10.6.0-alpha.5",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "8.2.1",
        "vitest": "4.1.10"
    },
    "browserslist": [
        "Chrome >= 140",
        "Firefox >= 133",
        "Safari >= 18.4"
    ]
}
