          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "state": {
          "const": "unavailable"
        }
      },
      "required": [
        "checkedAtMs",
        "state"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "actionActive": {
          "type": "boolean"
        },
