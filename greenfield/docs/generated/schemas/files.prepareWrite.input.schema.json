{
  "$id": "urn:mira-dashboard:files.prepareWrite.input",
  "type": "object",
  "properties": {
    "expectedRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mimeType": {
      "type": "string",
      "maxLength": 129,
      "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}\\/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
    },
    "revealTicketId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "resourceId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777216
    }
  },
  "required": [
    "expectedRevision",
    "mimeType",
    "resourceId",
    "sizeBytes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
