{
  "$id": "urn:mira-dashboard:cache.getHeartbeat.output",
  "type": "object",
  "properties": {
    "cache": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "consecutiveFailures": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "failureCode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9._/-]*$"
              },
              "failureMessage": {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1,
                "pattern": "\\S",
                "allOf": [
                  {
                    "pattern": "^[^\\u0000]*$"
                  },
                  {
                    "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]*$"
                  }
                ]
              },
              "lastAttemptAtMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8640000000000000
              },
              "lastAttemptDurationMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "lastAttemptNumber": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "lastAttemptRunId": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "lastAttemptStatus": {
                "enum": [
                  "failed",
                  "succeeded"
                ],
                "type": "string"
              },
              "updatedAtMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8640000000000000
              },
              "freshness": {
                "enum": [
                  "fresh",
                  "missing",
                  "stale"
                ],
                "type": "string"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "manualRunAvailable": {
                "type": "boolean"
              },
              "expiresAtMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8640000000000000
              },
              "lastSuccessAtMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8640000000000000
              },
              "metadata": {
                "type": "object",
                "$comment": "Live Valibot validation additionally requires an acyclic plain JSON object with bounded depth, finite safe-magnitude numbers, and no sparse arrays. Live Valibot validation additionally limits serialized cache metadata to its reviewed UTF-8 byte budget."
              },
              "schemaId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "source": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "\\S",
                "allOf": [
                  {
                    "pattern": "^[^\\u0000]*$"
                  },
                  {
                    "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]*$"
                  }
                ]
              }
            },
            "required": [
              "consecutiveFailures",
              "lastAttemptAtMs",
              "lastAttemptDurationMs",
              "lastAttemptNumber",
              "lastAttemptRunId",
              "lastAttemptStatus",
              "updatedAtMs",
              "freshness",
              "key",
              "manualRunAvailable"
            ],
            "additionalProperties": false,
            "$comment": "Live Valibot validation additionally requires payload-free cache status fields to agree."
          },
          "maxItems": 128,
          "$comment": "Live Valibot validation additionally requires strict ascending cache-key order."
        },
        "generatedAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "totalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "generatedAtMs",
        "totalCount",
        "truncated"
      ],
      "additionalProperties": false,
      "$comment": "Live Valibot validation additionally requires cache totals, truncation, snapshot timestamps, and freshness relative to the snapshot clock to agree."
    },
    "gateway": {
      "type": "object",
      "properties": {
        "connection": {
          "type": "object",
          "properties": {
            "checkedAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "freshness": {
              "enum": [
                "fresh",
                "stale",
                "unavailable"
              ],
              "type": "string"
            },
            "phase": {
              "enum": [
                "connected",
                "connecting",
                "degraded",
                "stopped",
                "stopping"
              ],
              "type": "string"
            }
          },
          "required": [
            "checkedAtMs",
            "freshness",
            "phase"
          ],
          "additionalProperties": false,
          "$comment": "Live Valibot validation additionally requires the compact Gateway phase and connection freshness to agree."
        },
        "sessions": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "unavailable"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                },
                "observedAtMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8640000000000000
                },
                "state": {
                  "const": "fresh"
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "count",
                "observedAtMs",
                "state",
                "truncated"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                },
                "observedAtMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8640000000000000
                },
                "staleSinceMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8640000000000000
                },
                "state": {
                  "const": "last-known-good"
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "count",
                "observedAtMs",
                "staleSinceMs",
                "state",
                "truncated"
              ],
              "additionalProperties": false,
              "$comment": "Live Valibot validation additionally requires compact Gateway-session staleness to begin at or after the last observation."
            }
          ]
        }
      },
      "required": [
        "connection",
        "sessions"
      ],
      "additionalProperties": false
    },
    "generatedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "openClawCron": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "pendingSync": {
              "enum": [
                "present",
                "unknown"
              ],
              "type": "string"
            },
            "state": {
              "const": "unavailable"
            }
          },
          "required": [
            "pendingSync",
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "observedAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "pendingSync": {
              "enum": [
                "none",
                "present",
                "unknown"
              ],
              "type": "string"
            },
            "state": {
              "const": "fresh"
            }
          },
          "required": [
            "count",
            "observedAtMs",
            "pendingSync",
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "observedAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "pendingSync": {
              "enum": [
                "none",
                "present",
                "unknown"
              ],
              "type": "string"
            },
            "staleSinceMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "state": {
              "const": "last-known-good"
            }
          },
          "required": [
            "count",
            "observedAtMs",
            "pendingSync",
            "staleSinceMs",
            "state"
          ],
          "additionalProperties": false,
          "$comment": "Live Valibot validation additionally requires compact OpenClaw-cron staleness to begin at or after the last observation."
        }
      ]
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": [
    "cache",
    "gateway",
    "generatedAtMs",
    "openClawCron",
    "schemaVersion"
  ],
  "additionalProperties": false,
  "$comment": "Live Valibot validation additionally requires nested heartbeat observations not to exceed the clamped response clock and cached projections not to remain fresh while Gateway is disconnected.",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
