{
  "$id": "urn:mira-dashboard:schedules.list.input",
  "type": "object",
  "properties": {
    "cursor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "enabled": {
      "enum": [
        "all",
        "disabled",
        "enabled"
      ],
      "type": "string",
      "default": "all"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 50
    }
  },
  "required": [],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
