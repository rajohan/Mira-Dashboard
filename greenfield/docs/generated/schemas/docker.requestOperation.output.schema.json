{
  "$id": "urn:mira-dashboard:docker.requestOperation.output",
  "type": "object",
  "properties": {
    "jobRunId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": {
      "enum": [
        "container-restart",
        "container-start",
        "container-stop",
        "image-delete",
        "prune-execute",
        "stack-restart",
        "stack-start",
        "stack-stop",
        "updater-run",
        "updater-scan",
        "updater-update-service",
        "volume-delete"
      ],
      "type": "string"
    },
    "queued": {
      "const": true
    }
  },
  "required": [
    "jobRunId",
    "operation",
    "queued"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
