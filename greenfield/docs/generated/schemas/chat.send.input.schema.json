{
  "$id": "urn:mira-dashboard:chat.send.input",
  "type": "object",
  "properties": {
    "attachmentTicketId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "clientRunId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
    },
    "message": {
      "type": "string",
      "maxLength": 262144,
      "pattern": "^[^\\u0000]*$"
    },
    "queueMode": {
      "enum": [
        "collect",
        "followup",
        "interrupt",
        "steer"
      ],
      "type": "string"
    },
    "sessionKey": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "\\S",
      "allOf": [
        {
          "pattern": "^[^\\u0000]*$"
        },
        {
          "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]*$"
        }
      ]
    },
    "settings": {
      "type": "object",
      "properties": {
        "fastMode": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "auto"
            }
          ]
        },
        "thinkingLevel": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "allOf": [
            {
              "pattern": "^[^\\u0000]*$"
            },
            {
              "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]*$"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "clientRunId",
    "idempotencyKey",
    "message",
    "sessionKey"
  ],
  "additionalProperties": false,
  "$comment": "Live Valibot validation additionally requires nonblank chat text or an attachment ticket. Live Valibot validation additionally limits the canonical serialized chat send intent to 131072 UTF-8 bytes, stricter than the shared history-message code-unit cap.",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
