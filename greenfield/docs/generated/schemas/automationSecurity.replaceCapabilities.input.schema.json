{
  "$id": "urn:mira-dashboard:automationSecurity.replaceCapabilities.input",
  "type": "object",
  "properties": {
    "expectedAuthorizationVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "principalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "agents:read",
          "agents:write",
          "notifications:read",
          "reports:read",
          "tasks:read",
          "tasks:write"
        ],
        "type": "string"
      },
      "maxItems": 6,
      "uniqueItems": true
    }
  },
  "required": [
    "expectedAuthorizationVersion",
    "principalId",
    "capabilities"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
