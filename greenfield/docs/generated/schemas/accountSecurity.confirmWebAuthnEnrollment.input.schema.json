{
  "$id": "urn:mira-dashboard:accountSecurity.confirmWebAuthnEnrollment.input",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]+$"
    },
    "response": {
      "type": "object",
      "properties": {
        "authenticatorAttachment": {
          "enum": [
            "cross-platform",
            "platform"
          ],
          "type": "string"
        },
        "clientExtensionResults": {
          "type": "object",
          "properties": {
            "credProps": {
              "type": "object",
              "properties": {
                "rk": {
                  "type": "boolean"
                }
              },
              "required": [
                "rk"
              ],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1024,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
        },
        "rawId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1024,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
        },
        "response": {
          "type": "object",
          "properties": {
            "attestationObject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
            },
            "authenticatorData": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
            },
            "clientDataJSON": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
            },
            "publicKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
            },
            "publicKeyAlgorithm": {
              "const": -7
            },
            "transports": {
              "type": "array",
              "items": {
                "enum": [
                  "ble",
                  "cable",
                  "hybrid",
                  "internal",
                  "nfc",
                  "smart-card",
                  "usb"
                ],
                "type": "string"
              },
              "maxItems": 7,
              "uniqueItems": true
            }
          },
          "required": [
            "attestationObject",
            "clientDataJSON"
          ],
          "additionalProperties": false
        },
        "type": {
          "const": "public-key"
        }
      },
      "required": [
        "clientExtensionResults",
        "id",
        "rawId",
        "response",
        "type"
      ],
      "additionalProperties": false,
      "$comment": "Live Valibot validation additionally requires id and rawId to match exactly."
    }
  },
  "required": [
    "response"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
