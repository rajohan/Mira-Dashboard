{
  "$id": "urn:mira-dashboard:logs.tail.output",
  "type": "object",
  "properties": {
    "hasEarlier": {
      "type": "boolean"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "line": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$"
          },
          "severity": {
            "enum": [
              "trace",
              "debug",
              "info",
              "warn",
              "error",
              "fatal",
              "unknown"
            ],
            "type": "string"
          },
          "timestampMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8640000000000000
          }
        },
        "required": [
          "id",
          "line",
          "severity"
        ],
        "additionalProperties": false
      },
      "maxItems": 500,
      "$comment": "Live Valibot validation additionally requires every redacted log line ID to be unique."
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scannedBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    }
  },
  "required": [
    "hasEarlier",
    "lines",
    "observedAtMs",
    "revision",
    "scannedBytes",
    "sourceId"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
