{
  "$id": "urn:mira-dashboard:tasks.addUpdate.input",
  "type": "object",
  "properties": {
    "messageMarkdown": {
      "type": "string",
      "maxLength": 20000,
      "minLength": 1,
      "pattern": "\\S",
      "allOf": [
        {
          "pattern": "^[^\\u0000]*$"
        }
      ]
    },
    "taskId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "messageMarkdown",
    "taskId"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
