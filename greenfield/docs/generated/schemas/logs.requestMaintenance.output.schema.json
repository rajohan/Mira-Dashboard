{
  "$id": "urn:mira-dashboard:logs.requestMaintenance.output",
  "type": "object",
  "properties": {
    "dryRun": {
      "type": "boolean"
    },
    "jobRunId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "policyId": {
      "enum": [
        "docker-managed",
        "host-alternatives",
        "host-apport",
        "host-dpkg",
        "host-rsyslog"
      ],
      "type": "string"
    },
    "queued": {
      "const": true
    }
  },
  "required": [
    "dryRun",
    "jobRunId",
    "policyId",
    "queued"
  ],
  "additionalProperties": false,
  "$comment": "Live Valibot validation additionally permits a queued dry-run result only for the fixed docker-managed policy.",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
