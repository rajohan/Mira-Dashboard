{
  "$id": "urn:mira-dashboard:notifications.markAllRead.output",
  "type": "object",
  "properties": {
    "affectedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "completedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "remaining": {
      "type": "boolean"
    }
  },
  "required": [
    "affectedCount",
    "completedAtMs",
    "remaining"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "remaining": {
            "const": true
          }
        },
        "required": [
          "remaining"
        ]
      },
      "then": {
        "properties": {
          "affectedCount": {
            "const": 100
          }
        },
        "required": [
          "affectedCount"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
