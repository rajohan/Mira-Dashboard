{
  "$id": "urn:mira-dashboard:openClawCron.listRuns.output",
  "type": "object",
  "properties": {
    "freshness": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "fresh"
            },
            "observedAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "observedAtMs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "last-known-good"
            },
            "observedAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "staleSinceMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "observedAtMs",
            "staleSinceMs"
          ],
          "additionalProperties": false,
          "$comment": "Live Valibot validation additionally requires staleness to begin at or after the last observation."
        }
      ]
    },
    "hasMore": {
      "type": "boolean"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "nextOffset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "completedAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "deliveryStatus": {
            "enum": [
              "delivered",
              "not-delivered",
              "not-requested",
              "unknown"
            ],
            "type": "string"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "errorReason": {
            "enum": [
              "auth",
              "auth_permanent",
              "billing",
              "context_overflow",
              "empty_response",
              "format",
              "model_not_found",
              "no_error_details",
              "overloaded",
              "rate_limit",
              "server_error",
              "session_expired",
              "timeout",
              "unclassified",
              "unknown"
            ],
            "type": "string"
          },
          "jobId": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "\\S",
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              },
              {
                "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]*$"
              }
            ]
          },
          "model": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "\\S",
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              },
              {
                "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]*$"
              }
            ]
          },
          "modelTruncated": {
            "type": "boolean"
          },
          "provider": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              },
              {
                "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]*$"
              }
            ]
          },
          "providerTruncated": {
            "type": "boolean"
          },
          "runAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "runId": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "\\S",
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              },
              {
                "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]*$"
              }
            ]
          },
          "status": {
            "enum": [
              "error",
              "ok",
              "skipped",
              "unknown"
            ],
            "type": "string"
          },
          "summary": {
            "type": "string",
            "maxLength": 4000
          },
          "summaryTruncated": {
            "type": "boolean"
          },
          "usage": {
            "type": "object",
            "properties": {
              "cacheReadTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cacheWriteTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "inputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "totalTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "completedAtMs",
          "deliveryStatus",
          "jobId",
          "modelTruncated",
          "providerTruncated",
          "status",
          "summaryTruncated"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "freshness",
    "hasMore",
    "limit",
    "offset",
    "runs",
    "total"
  ],
  "additionalProperties": false,
  "$comment": "Live Valibot validation additionally requires run rows, offsets, continuation, and total count to describe one coherent bounded page.",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
