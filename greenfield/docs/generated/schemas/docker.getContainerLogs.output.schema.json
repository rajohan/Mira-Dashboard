{
  "$id": "urn:mira-dashboard:docker.getContainerLogs.output",
  "type": "object",
  "properties": {
    "containerId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^[^\\u0000]*$"
      },
      "maxItems": 500
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "redacted": {
      "const": true
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "containerId",
    "lines",
    "observedAtMs",
    "redacted",
    "sourceRevision",
    "truncated"
  ],
  "additionalProperties": false,
  "$comment": "Live Valibot validation additionally limits the serialized sanitized Docker log response to 256 KiB of UTF-8.",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
