{
  "$id": "urn:mira-dashboard:automationSecurity.createPrincipal.output",
  "type": "object",
  "properties": {
    "credential": {
      "type": "object",
      "properties": {
        "createdAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]+$"
        },
        "prefix": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32,
          "pattern": "^[0-9a-f]{32}$"
        },
        "replacesCredentialId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revokedAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        }
      },
      "required": [
        "createdAtMs",
        "id",
        "label",
        "prefix"
      ],
      "additionalProperties": false,
      "$comment": "Live Valibot validation additionally requires credential expiry after creation and revocation no earlier than creation. Live Valibot validation additionally requires a replacement credential to reference a different credential ID."
    },
    "principal": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "activeCredentialCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "authorizationVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "capabilities": {
              "type": "array",
              "items": {
                "enum": [
                  "agents:read",
                  "agents:write",
                  "cache:read",
                  "cache:write",
                  "chat:read",
                  "chat:write",
                  "files:read",
                  "files:write",
                  "gateway-sessions:read",
                  "gateway-sessions:write",
                  "jobs:read",
                  "jobs:write",
                  "logs:read",
                  "logs:write",
                  "monitoring:write",
                  "notifications:read",
                  "notifications:write",
                  "openclaw-tasks:read",
                  "openclaw-tasks:write",
                  "reports:read",
                  "reports:write",
                  "tasks:read",
                  "tasks:write",
                  "terminal:read",
                  "terminal:write"
                ],
                "type": "string"
              },
              "maxItems": 25,
              "uniqueItems": true
            },
            "createdAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]+$"
            },
            "totalCredentialCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "updatedAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "disabled": {
              "const": false
            }
          },
          "required": [
            "activeCredentialCount",
            "authorizationVersion",
            "capabilities",
            "createdAtMs",
            "id",
            "label",
            "totalCredentialCount",
            "updatedAtMs",
            "disabled"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "activeCredentialCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "authorizationVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "capabilities": {
              "type": "array",
              "items": {
                "enum": [
                  "agents:read",
                  "agents:write",
                  "cache:read",
                  "cache:write",
                  "chat:read",
                  "chat:write",
                  "files:read",
                  "files:write",
                  "gateway-sessions:read",
                  "gateway-sessions:write",
                  "jobs:read",
                  "jobs:write",
                  "logs:read",
                  "logs:write",
                  "monitoring:write",
                  "notifications:read",
                  "notifications:write",
                  "openclaw-tasks:read",
                  "openclaw-tasks:write",
                  "reports:read",
                  "reports:write",
                  "tasks:read",
                  "tasks:write",
                  "terminal:read",
                  "terminal:write"
                ],
                "type": "string"
              },
              "maxItems": 25,
              "uniqueItems": true
            },
            "createdAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*(?:[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]|\\uD804[\\uDCBD\\uDCCD]|\\uD80D[\\uDC30-\\uDC3F]|\\uD82F[\\uDCA0-\\uDCA3]|\\uD834[\\uDD73-\\uDD7A]|\\uDB40(?:\\uDC01|[\\uDC20-\\uDC7F])))[\\s\\S]+$"
            },
            "totalCredentialCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "updatedAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "disabled": {
              "const": true
            },
            "disabledAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            }
          },
          "required": [
            "activeCredentialCount",
            "authorizationVersion",
            "capabilities",
            "createdAtMs",
            "id",
            "label",
            "totalCredentialCount",
            "updatedAtMs",
            "disabled",
            "disabledAtMs"
          ],
          "additionalProperties": false
        }
      ],
      "$comment": "Live Valibot validation additionally orders principal creation, update, and disable timestamps. Live Valibot validation additionally bounds active credentials by the total and requires zero active credentials when disabled."
    },
    "token": {
      "type": "string",
      "minLength": 97,
      "maxLength": 97,
      "pattern": "^[0-9a-f]{32}\\.[0-9a-f]{64}$"
    }
  },
  "required": [
    "credential",
    "principal",
    "token"
  ],
  "additionalProperties": false,
  "$comment": "Live Valibot validation additionally binds a new principal to one active initial credential and its matching one-time token prefix.",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
